<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plume for Samsung TVs (Tizen web app).
  The package id must stay exactly 10 characters.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://plume.local/samsung" version="2.9.0" viewmodes="maximized">
    <tizen:application id="PlumeTV001.Plume" package="PlumeTV001" required_version="5.5"/>
    <name>Plume</name>
    <description>A calm, ad-free home screen with Plex Continue Watching and today's football.</description>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <default_locale>en</default_locale>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <access origin="*" subdomains="true"/>
    <!-- highlights play through a page on GitHub Pages shown inside Plume: the TV must be allowed to load it -->
    <tizen:allow-navigation>*</tizen:allow-navigation>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://tizen.org/privilege/mediastorage"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; img-src * data: blob: file:;</tizen:content-security-policy>
</widget>
